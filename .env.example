# ============================================================
# PaperTradeAgent 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ── DeepSeek LLM API ──
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Flash: 快速轻量模型，简单任务（对话/分类/文本结构化/舆情处理）
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# Pro: 深度推理模型，复杂任务（技术分析/交易计划/股价预估/风险研判/报告生成）
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ── Database ──
DB_PATH=backend/database/paper_trade.db

# ── Backend Server ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# ── Frontend Server ──
FRONTEND_PORT=5173

# ── Auth (MVP) ──
TEST_TOKEN=Bearer mvp_test_token_2026
TEST_USER_ID=default

# ── Trading Simulation ──
INITIAL_BALANCE=1000000.00
WATCHLIST_MAX_SIZE=3

# ── Polling & Cache ──
LIVE_PRICE_POLL_INTERVAL=2
PRICE_CACHE_TTL=3
KLINE_CACHE_TTL=3600
API_RATE_LIMIT=25
API_RATE_WINDOW=60

# ── HTTP Timeouts ──
HTTP_TIMEOUT_STOCK=10
HTTP_TIMEOUT_LLM_CHAT=60
HTTP_TIMEOUT_LLM_STREAM=120

# ── Conversation Memory ──
MAX_RECENT_MESSAGES=20
MAX_TOTAL_MESSAGES=40
SUMMARY_TRIM_THRESHOLD=30

#uv run uvicorn backend.main:app --host 0.0.0.0 --port 8001 --reload
#npm run 


